{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Reference to Game entity"
    },
    "predicted_winner_id": {
      "type": "string",
      "description": "Team ID of predicted winner, or 'draw'"
    },
    "predicted_outcome": {
      "type": "string",
      "enum": [
        "home",
        "away",
        "draw"
      ],
      "description": "Which side the engine expects to win"
    },
    "confidence_score": {
      "type": "number",
      "description": "Overall confidence 0-100, shrunk toward chance when the sample is small"
    },
    "numerology_score": {
      "type": "number",
      "description": "Numerology-based score for the home team (0-100)"
    },
    "astrology_score": {
      "type": "number",
      "description": "Astrology-based score for the home team (0-100)"
    },
    "battle_stats_score": {
      "type": "number",
      "description": "Statistical expected-goals edge for the home team (0-100)"
    },
    "cosmic_energy_score": {
      "type": "number",
      "description": "Blended numerology and astrology alignment score"
    },
    "predicted_score_diff": {
      "type": "number",
      "description": "Goal differential of the most likely scoreline"
    },
    "bet_recommendation": {
      "type": "string",
      "enum": [
        "strong_bet",
        "moderate_bet",
        "light_bet",
        "no_bet"
      ],
      "description": "Strength of the lean, capped by sample size"
    },
    "suggested_units": {
      "type": "number",
      "description": "Suggested betting units (Kelly criterion)"
    },
    "prediction_notes": {
      "type": "string",
      "description": "Short summary of the call"
    },
    "scenarios": {
      "type": "string",
      "description": "JSON string of the ranked scoreline scenarios with likelihoods"
    },
    "rationale": {
      "type": "string",
      "description": "JSON string with verdict plus statistical and cosmic reasoning"
    },
    "input_snapshot": {
      "type": "string",
      "description": "JSON string of the exact team, cosmic and statistical inputs used, frozen at generation time"
    },
    "universal_day": {
      "type": "number",
      "description": "Universal day number of the match date"
    },
    "moon_phase": {
      "type": "string",
      "description": "Moon phase on the match date"
    },
    "data_quality": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "limited"
      ],
      "description": "How much completed-game data backed this reading"
    },
    "sample_games": {
      "type": "number",
      "description": "Smallest completed-game sample of the two teams at generation time"
    },
    "engine_version": {
      "type": "string",
      "description": "Version of the prediction engine that produced this reading"
    },
    "was_correct": {
      "type": "boolean",
      "description": "Whether the called outcome matched the final result"
    },
    "actual_winner_id": {
      "type": "string",
      "description": "Team ID of the actual winner, or 'draw'"
    },
    "actual_home_score": {
      "type": "number",
      "description": "Final home score, recorded after the match"
    },
    "actual_away_score": {
      "type": "number",
      "description": "Final away score, recorded after the match"
    },
    "reconciled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the result was recorded against this prediction"
    },
    "use_player_battle_stats": {
      "type": "boolean",
      "default": false,
      "description": "Whether to run player-vs-player battles for this prediction"
    },
    "player_battle_results": {
      "type": "string",
      "description": "JSON string of player battle simulation results"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this prediction has been archived"
    }
  },
  "required": [
    "game_id",
    "predicted_winner_id"
  ]
}